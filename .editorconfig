# EditorConfig (https://editorconfig.org) — baseline formatting for
# editors. Rust indentation matches rustfmt's defaults; rustfmt remains the
# authority for .rs files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false
