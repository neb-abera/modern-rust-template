# Files this repository shares with modern-webapp-template and must keep
# byte-identical to its default branch. A change to one of these lands in
# the template first. The template's scripts/check-template-parity.sh reads
# a list in this format and compares each path with the template on every
# pull request. This repository does not run that check yet.
#
# Format: one path per line; the first line names the template.
template: neb-abera/modern-webapp-template
scripts/check-prose.sh
.vale.ini
.vale/fixtures/fails.md
.vale/fixtures/passes.md
.vale/styles/Abera/Buzzwords.yml
